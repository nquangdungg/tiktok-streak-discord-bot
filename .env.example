# Discord Bot Token (lấy từ https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Prefix lệnh (nếu dùng prefix commands)
PREFIX=!

# Cài đặt TikTok (có thể override qua Discord)
STREAK_MESSAGE=🔥 Streak Reminder 🔥
HEADLESS_MODE=true
PAGE_LOAD_WAIT=5
ELEMENT_WAIT=3
MESSAGE_SEND_DELAY=2
